# Set this on the backend host or in the backend process environment.
# Use a long, random secret. Never expose this value to the frontend.
SANAD_ADMIN_TOKEN=replace-with-a-long-random-secret

# Comma-separated exact frontend origins allowed to call the API.
# Local development:
SANAD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
