# Set this on the backend host or in the backend process environment.
# Use a long, random secret. Never expose this value to the frontend.
SANAD_ADMIN_TOKEN=replace-with-a-long-random-secret

# Comma-separated exact frontend origins allowed to call the API.
# Local development:
SANAD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Account session cookies.
# Local development defaults are suitable for localhost.
# For separate frontend/backend origins in production, use HTTPS and:
# SANAD_COOKIE_SECURE=true
# SANAD_COOKIE_SAMESITE=none
SANAD_COOKIE_SECURE=false
SANAD_COOKIE_SAMESITE=lax

# OAuth 2.0 Web Client ID from Google Cloud Console (same value used by VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
