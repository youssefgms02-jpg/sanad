{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SANAD",
  "version": "1.0.0",
  "identifier": "eg.sanad.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "سَنَد | SANAD",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "منصة عربية للوصول إلى الخدمات والمعلومات الرسمية",
    "longDescription": "سَنَد يساعد المستخدم على فهم الخدمات المصرية والوصول إلى مصادرها الرسمية.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWSAclRnAsNpVZ+sHX2Zk7+9LILTneQrDu3mNSS2iqJJ3HOai8fD/w9H",
      "endpoints": [
        "https://github.com/youssefgms02-jpg/sanad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
